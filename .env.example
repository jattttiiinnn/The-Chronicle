# --- Frontend (exposed to the browser) ---
# The app calls the real backend by default. Set VITE_API_MODE=mock only to run
# against the in-browser fake API (no server or database needed).
VITE_API_MODE=live
# Leave empty for same-origin requests (Vite proxy locally, Vercel in production).
# Set an absolute URL only when the API is hosted on a different origin.
VITE_API_URL=

# --- Backend (server-side only, never exposed to the browser) ---
# MongoDB Atlas connection string. Create a free M0 cluster at
# https://www.mongodb.com/cloud/atlas and copy the "Drivers" string here.
# Use 0.0.0.0/0 in Atlas Network Access so Vercel's functions can connect.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=chronicle
# Long random string used to sign login tokens: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Password given to every seeded demo account (default: password123)
SEED_PASSWORD=password123
